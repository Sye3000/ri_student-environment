            date: "2026-08-15",
            deliveryDate: "2026-08-18",
            total: 960,
            quantity: 2,
            status: "Delivered",
            lastUpdate: "2026-08-18",
            reference: "HOODIE-1048",
            items: [{ id: 1, name: "Signature Campus Hoodie", quantity: 2 }]
        },
        {
            id: "ST-1193",
            date: "2026-08-27",
            deliveryDate: "2026-08-30",
            total: 480,
            quantity: 1,
            status: "In transit",
            lastUpdate: "2026-08-29",
            reference: "HOODIE-1193",
            items: [{ id: 1, name: "Signature Campus Hoodie", quantity: 1 }]
        },
        {
            id: "ST-1227",
            date: "2026-09-02",
            deliveryDate: "2026-09-05",
            total: 1440,
            quantity: 3,
            status: "Processing",

const savedStudent = localStorage.getItem("ri_student");

let studentWalletId = "guest";

if (savedStudent) {
    try {
        const student = JSON.parse(savedStudent);
        studentWalletId = student.student_number || student.student_id || student.email || "guest";
    } catch {
        studentWalletId = "guest";
    }
}

const walletKey = `studentWallet_${studentWalletId}`;

const savedWallet = localStorage.getItem(walletKey);

const wallet = savedWallet ? JSON.parse(savedWallet) : { balance: 1000, transactions: [] };

function saveWallet() {
    localStorage.setItem(walletKey, JSON.stringify(wallet));
}

function updateWalletDisplay() {
    const balanceElement = document.getElementById("walletBalance");
    if (!balanceElement) return;
    balanceElement.textContent = `R${wallet.balance.toFixed(2)}`;
}

function addFunds(amount) {
    if (amount <= 0) return false;

    wallet.balance += amount;
    wallet.transactions.push({ type: "top-up", amount, date: new Date().toISOString() });

    saveWallet();
    updateWalletDisplay();
    return true;
}

const cartKey = "storeCart";
const savedCart = localStorage.getItem(cartKey);
const cart = savedCart ? JSON.parse(savedCart) : [];
const storeOrderHistoryKey = "ri_store_order_history";

const products = [
    { id: 1, name: "Signature Campus Hoodie", price: 480, cat: "clothing", image: "Hoodies.jpeg", description: "Heavyweight fleece hoodie with premium knit finish and bold campus branding." }
];


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Manage your student identity, campus information and account activity."
    >

    <title>My Profile | RI Student Environment</title>

    <link rel="stylesheet" href="lostfound.css">
    <link rel="stylesheet" href="profile.css">
</head>

<body class="lf-page dashboard-page profile-page">

    <!-- =========================
         HEADER
    ========================== -->

    <header class="lf-header">

        <div class="lf-header-inner">

            <button
                type="button"
                class="lf-menu-toggle"
                id="hamburgerBtn"
                aria-label="Open navigation"
                aria-controls="sidebarDrawer"
                aria-expanded="false"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

            <a
                href="dashboard.html"
                class="lf-header-brand"
            >
                <img
                    src="Rosebank Logo.webp"
                    alt="RI Student Environment"
                >
            </a>

            <div class="lf-header-spacer"></div>

            <button
                type="button"
                class="lf-notification-button"
                aria-label="Notifications"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                    <path d="M10 21h4"></path>
                </svg>

                <span class="lf-notification-dot"></span>
            </button>

            <a
                href="profile.html"
                class="lf-header-profile"
                aria-label="Open profile"
            >

                <span
                    class="lf-header-avatar"
                    id="header-student-initial"
                >
                    S
                </span>

                <span class="lf-header-profile-text">

                    <strong id="header-student-name">
                        Student
                    </strong>

                    <small id="header-student-role">
                        Student
                    </small>

                </span>

            </a>

        </div>

    </header>


    <!-- =========================
         MOBILE OVERLAY
    ========================== -->

    <div
        class="lf-sidebar-overlay"
        id="sidebarOverlay"
        hidden
    ></div>


    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside
        class="lf-sidebar"
        id="sidebarDrawer"
        aria-label="Student navigation"
    >

        <div class="lf-sidebar-top">

            <div class="lf-sidebar-mobile-head">

                <span>
                    Student Portal
                </span>

                <button
                    type="button"
                    id="sidebarClose"
                    aria-label="Close navigation"
                >
                    ×
                </button>

            </div>


            <div class="lf-sidebar-label">
                STUDENT PORTAL
            </div>


            <nav class="lf-sidebar-nav">

                <a
                    href="dashboard.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                    </span>
                    <span>Dashboard</span>
                </a>


                <a
                    href="profile.html"
                    class="lf-sidebar-link active"
                    aria-current="page"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="3.2"></circle>
                            <path d="M5 20a7 7 0 0 1 14 0"></path>
                        </svg>
                    </span>
                    <span>Profile</span>
                </a>


                <a
                    href="events.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <path d="M8 3v4M16 3v4M3 10h18"></path>
                        </svg>
                    </span>
                    <span>Events</span>
                </a>


                <a
                    href="programs.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 5h16v14H4z"></path>
                            <path d="M8 9h8M8 13h5"></path>
                        </svg>
                    </span>
                    <span>Programs</span>
                </a>


                <a
                    href="community.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="9" cy="8" r="3"></circle>
                            <path d="M3.5 19a5.5 5.5 0 0 1 11 0"></path>
                            <path d="M16 5.5a3 3 0 0 1 0 5.8"></path>
                            <path d="M16.5 14a5 5 0 0 1 4 5"></path>
                        </svg>
                    </span>
                    <span>Community</span>
                </a>


                <a
                    href="src.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3l2.4 5 5.6.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.6-.8z"></path>
                        </svg>
                    </span>
                    <span>SRC</span>
                </a>


                <a
                    href="lostfound.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 7.5A2.5 2.5 0 0 1 7.5 5h9A2.5 2.5 0 0 1 19 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 16.5z"></path>
                            <circle cx="9" cy="9.5" r="1.2"></circle>
                            <path d="m9 15 2.2-2.2a1.5 1.5 0 0 1 2.1 0L15 14.5"></path>
                        </svg>
                    </span>
                    <span>Lost &amp; Found</span>
                </a>


                <a
                    href="store.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 8h12l1 13H5L6 8z"></path>
                            <path d="M9 8a3 3 0 0 1 6 0"></path>
                        </svg>
                    </span>
                    <span>Store</span>
                </a>


                <a
                    href="resturant.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3v8"></path>
                            <path d="M4.5 3v5a2.5 2.5 0 0 0 5 0V3"></path>
                            <path d="M7 11v10"></path>
                            <path d="M16 3v18"></path>
                            <path d="M16 3c2.2 1.5 3.5 3.6 3.5 6 0 1.8-1.1 3-3.5 3"></path>
                        </svg>
                    </span>
                    <span>Dining</span>
                </a>

            </nav>


            <div class="lf-sidebar-divider"></div>


            <div class="lf-sidebar-label">
                ACCOUNT
            </div>


            <nav class="lf-sidebar-nav">

                <a
                    href="settings.html"
                    class="lf-sidebar-link"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"></path>
                            <path d="M19 13.5v-3l-2-.6a7 7 0 0 0-.8-1.8l.9-1.9-2.1-2.1-1.9.9a7 7 0 0 0-1.8-.8L10.5 2h3l.6 2a7 7 0 0 1 1.8.8l1.9-.9 2.1 2.1-.9 1.9c.4.6.7 1.2.8 1.8z"></path>
                        </svg>
                    </span>
                    <span>Settings</span>
                </a>


                <a
                    href="index.html"
                    class="lf-sidebar-link logout-button"
                >
                    <span class="lf-sidebar-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 4H5v16h5"></path>
                            <path d="M14 8l4 4-4 4"></path>
                            <path d="M9 12h9"></path>
                        </svg>
                    </span>
                    <span>Logout</span>
                </a>

            </nav>

        </div>


        <div class="lf-sidebar-footer">

            <div class="lf-sidebar-campus">

                <span class="lf-campus-status"></span>

                <div>
                    <strong id="sidebarCampusName">
                        Your Campus
                    </strong>

                    <small>
                        Student Environment
                    </small>
                </div>

            </div>

        </div>

    </aside>


    <!-- =========================
         MAIN
    ========================== -->

    <main class="lf-main profile-main">

        <!-- PROFILE HERO -->

        <section class="profile-hero-v2">

            <div class="profile-hero-copy">

                <p class="profile-kicker">
                    STUDENT PROFILE
                </p>

                <h1>
                    Your student identity
                </h1>

                <p class="profile-hero-description">
                    Manage your student information, campus details,
                    account status and student services from one place.
                </p>

            </div>


            <div class="profile-identity-card">

                <div class="profile-avatar-large">

                    <img
                        id="profile-picture"
                        src="Technology and Innovation.jpeg"
                        alt="Student profile picture"
                    >

                    <span
                        class="profile-online-indicator"
                        title="Account active"
                    ></span>

                </div>


                <div class="profile-identity-details">

                    <span class="profile-identity-label">
                        STUDENT
                    </span>

                    <h2 id="profile-hero-name">
                        Student
                    </h2>

                    <p id="profile-hero-number">
                        Loading student number...
                    </p>

                    <span class="profile-role-badge">
                        <span id="profile-hero-role">
                            Student
                        </span>
                    </span>

                </div>

            </div>

        </section>


        <!-- ACCOUNT OVERVIEW -->

        <section class="profile-section">

            <div class="profile-section-heading">

                <div>
                    <p class="profile-eyebrow">
                        ACCOUNT OVERVIEW
                    </p>

                    <h2>
                        Student account
                    </h2>
                </div>

            </div>


            <div class="profile-overview-grid">

                <!-- WALLET -->

                <article class="profile-wallet-card">

                    <div class="profile-card-top">

                        <div>
                            <span class="profile-card-label">
                                AVAILABLE BALANCE
                            </span>

                            <div class="profile-balance">
                                R<span id="student-wallet-balance">
                                    0.00
                                </span>
                            </div>
                        </div>

                        <span class="profile-card-icon wallet">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H19a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 1 4 17.5z"></path>
                                <path d="M4 7h14a2 2 0 0 1 2 2v1H15a2 2 0 0 0 0 4h5"></path>
                                <path d="M16 12h.01"></path>
                            </svg>
                        </span>

                    </div>

                    <p>
                        Your student wallet can be used for
                        supported campus services.
                    </p>

                    <a
                        href="store.html"
                        class="profile-card-action"
                    >
                        Manage spending
                        <span>→</span>
                    </a>

                </article>


                <!-- ACCOUNT STATUS -->

                <article class="profile-status-card">

                    <div class="profile-card-top">

                        <div>
                            <span class="profile-card-label">
                                ACCOUNT STATUS
                            </span>

                            <strong
                                id="profile-status"
                                class="profile-status-value"
                            >
                                Loading...
                            </strong>
                        </div>

                        <span class="profile-card-icon status">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z"></path>
                                <path d="m9 12 2 2 4-4"></path>
                            </svg>
                        </span>

                    </div>

                    <p>
                        Your account status determines access
                        to the student portal.
                    </p>

                    <span class="profile-status-note">
                        Student portal access
                    </span>

                </article>

            </div>

        </section>


        <!-- STUDENT INFORMATION -->

        <section class="profile-section">

            <div class="profile-section-heading">

                <div>
                    <p class="profile-eyebrow">
                        STUDENT DETAILS
                    </p>

                    <h2>
                        Your information
                    </h2>

                    <p>
                        Information associated with your student account.
                    </p>
                </div>

            </div>


            <div class="profile-information-grid">

                <!-- PERSONAL INFORMATION -->

                <article class="profile-detail-card">

                    <div class="profile-detail-header">

                        <span class="profile-detail-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="8" r="3"></circle>
                                <path d="M5 20a7 7 0 0 1 14 0"></path>
                            </svg>
                        </span>

                        <div>
                            <span class="profile-card-label">
                                IDENTITY
                            </span>

                            <h3>
                                Personal information
                            </h3>
                        </div>

                    </div>


                    <div class="profile-detail-list">

                        <div class="profile-detail-row">
                            <span>Full Name</span>
                            <strong id="profile-full-name">
                                Loading...
                            </strong>
                        </div>

                        <div class="profile-detail-row">
                            <span>Student Number</span>
                            <strong id="profile-student-number">
                                Loading...
                            </strong>
                        </div>

                        <div class="profile-detail-row">
                            <span>Email Address</span>
                            <strong id="profile-email">
                                Loading...
                            </strong>
                        </div>

                        <div class="profile-detail-row">
                            <span>Role</span>
                            <strong id="profile-role">
                                Loading...
                            </strong>
                        </div>

                    </div>

                </article>


                <!-- CAMPUS INFORMATION -->

                <article class="profile-detail-card">

                    <div class="profile-detail-header">

                        <span class="profile-detail-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 21V6l8-3 8 3v15"></path>
                                <path d="M8 21v-6h8v6"></path>
                                <path d="M8 9h.01M12 9h.01M16 9h.01M8 12h.01M16 12h.01"></path>
                            </svg>
                        </span>

                        <div>
                            <span class="profile-card-label">
                                CAMPUS
                            </span>

                            <h3>
                                Campus information
                            </h3>
                        </div>

                    </div>


                    <div class="profile-detail-list">

                        <div class="profile-detail-row">
                            <span>Campus</span>
                            <strong id="profile-campus">
                                Loading...
                            </strong>
                        </div>

                        <div class="profile-detail-row">
                            <span>Campus Code</span>
                            <strong id="profile-campus-code">
                                Loading...
                            </strong>
                        </div>

                        <div class="profile-detail-row">
                            <span>City</span>
                            <strong id="profile-city">
                                Loading...
                            </strong>
                        </div>

                    </div>

                </article>

            </div>

        </section>


        <!-- ACTIVITY -->

        <section class="profile-section">

            <div class="profile-section-heading">

                <div>
                    <p class="profile-eyebrow">
                        STUDENT ACTIVITY
                    </p>

                    <h2>
                        Your activity
                    </h2>

                    <p>
                        Your recent activity will appear here as
                        connected student services are used.
                    </p>
                </div>

            </div>


            <div class="profile-activity-grid">

                <article class="profile-activity-card">

                    <span class="profile-activity-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H19a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 1 4 17.5z"></path>
                            <path d="M4 7h14"></path>
                        </svg>
                    </span>

                    <div>
                        <span>Wallet</span>
                        <strong id="profile-wallet-activity">
                            Ready
                        </strong>
                    </div>

                </article>


                <article class="profile-activity-card">

                    <span class="profile-activity-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 8h12l1 13H5L6 8z"></path>
                            <path d="M9 8a3 3 0 0 1 6 0"></path>
                        </svg>
                    </span>

                    <div>
                        <span>Orders</span>
                        <strong id="profile-order-activity">
                            Connected
                        </strong>
                    </div>

                </article>


                <article class="profile-activity-card">

                    <span class="profile-activity-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 7.5A2.5 2.5 0 0 1 7.5 5h9A2.5 2.5 0 0 1 19 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 16.5z"></path>
                            <path d="m9 15 2.2-2.2a1.5 1.5 0 0 1 2.1 0L15 14.5"></path>
                        </svg>
                    </span>

                    <div>
                        <span>Lost &amp; Found</span>
                        <strong id="profile-lostfound-activity">
                            Connected
                        </strong>
                    </div>

                </article>


                <article class="profile-activity-card">

                    <span class="profile-activity-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 5h16v12H4z"></path>
                            <path d="m8 21 4-4 4 4"></path>
                        </svg>
                    </span>

                    <div>
                        <span>Community</span>
                        <strong id="profile-message-activity">
                            Connected
                        </strong>
                    </div>

                </article>

            </div>

        </section>


        <!-- ERROR -->

        <div
            id="profile-error"
            class="profile-error"
            role="alert"
            hidden
        >
            <strong>
                We could not load your profile.
            </strong>

            <span>
                Please check your connection and try again.
            </span>

            <a href="profile.html">
                Try again
            </a>
        </div>


        <!-- QUICK ACTIONS -->

        <section class="profile-section profile-services-section">

            <div class="profile-section-heading">

                <div>
                    <p class="profile-eyebrow">
                        STUDENT SERVICES
                    </p>

                    <h2>
                        Quick access
                    </h2>
                </div>

            </div>


            <div class="profile-services-grid">

                <a
                    href="store.html"
                    class="profile-service-card"
                >

                    <span class="profile-service-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 8h12l1 13H5L6 8z"></path>
                            <path d="M9 8a3 3 0 0 1 6 0"></path>
                        </svg>
                    </span>

                    <div>
                        <h3>University Store</h3>
                        <p>
                            Browse merchandise and manage purchases.
                        </p>
                    </div>

                    <span class="profile-service-arrow">
                        →
                    </span>

                </a>


                <a
                    href="resturant.html"
                    class="profile-service-card"
                >

                    <span class="profile-service-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3v8"></path>
                            <path d="M4.5 3v5a2.5 2.5 0 0 0 5 0V3"></path>
                            <path d="M7 11v10"></path>
                            <path d="M16 3v18"></path>
                            <path d="M16 3c2.2 1.5 3.5 3.6 3.5 6 0 1.8-1.1 3-3.5 3"></path>
                        </svg>
                    </span>

                    <div>
                        <h3>Campus Dining</h3>
                        <p>
                            Explore campus food and refreshments.
                        </p>
                    </div>

                    <span class="profile-service-arrow">
                        →
                    </span>

                </a>


                <a
                    href="lostfound.html"
                    class="profile-service-card"
                >

                    <span class="profile-service-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 7.5A2.5 2.5 0 0 1 7.5 5h9A2.5 2.5 0 0 1 19 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 16.5z"></path>
                            <circle cx="9" cy="9.5" r="1.2"></circle>
                            <path d="m9 15 2.2-2.2a1.5 1.5 0 0 1 2.1 0L15 14.5"></path>
                        </svg>
                    </span>

                    <div>
                        <h3>Lost &amp; Found</h3>
                        <p>
                            Report or browse items on your campus.
                        </p>
                    </div>

                    <span class="profile-service-arrow">
                        →
                    </span>

                </a>

            </div>

        </section>

    </main>


    <script src="sidebar.js"></script>
    <script src="app.js"></script>

</body>

</html>

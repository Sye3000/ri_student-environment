/* =========================================================
   RI STUDENT ENVIRONMENT
   PROFILE PAGE
========================================================= */

:root {
    --profile-blue: #1E40AF;
    --profile-blue-dark: #17358F;
    --profile-blue-deep: #102A72;
    --profile-blue-light: #EAF0FB;
    --profile-blue-soft: #F4F7FD;

    --profile-gold: #D4AF37;
    --profile-gold-dark: #B8941F;
    --profile-gold-light: #FBF7E8;

    --profile-white: #FFFFFF;
    --profile-grey-50: #F8F9FB;
    --profile-grey-100: #F3F4F6;
    --profile-grey-200: #E5E7EB;
    --profile-grey-300: #D1D5DB;
    --profile-grey-500: #6B7280;
    --profile-grey-600: #4B5563;
    --profile-grey-700: #374151;
    --profile-grey-900: #111827;

    --profile-success: #15803D;

    --profile-radius-sm: 10px;
    --profile-radius-md: 14px;
    --profile-radius-lg: 20px;

    --profile-shadow-sm: 0 4px 14px rgba(15, 23, 42, 0.05);
    --profile-shadow-md: 0 10px 30px rgba(15, 23, 42, 0.08);
}


/* =========================================================
   MAIN
========================================================= */

.profile-main {
    min-height: calc(100vh - 72px);
    padding: 34px 36px 60px;
    background: var(--profile-grey-50);
}


/* =========================================================
   PROFILE HERO
========================================================= */

.profile-hero-v2 {
    max-width: 1240px;
    margin: 0 auto 30px;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 460px);
    gap: 28px;
    align-items: stretch;
}

.profile-hero-copy {
    min-height: 250px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 38px;
    border: 1px solid var(--profile-grey-200);
    border-radius: var(--profile-radius-lg);

    background:
        linear-gradient(
            135deg,
            var(--profile-white) 0%,
            var(--profile-blue-soft) 100%
        );

    box-shadow: var(--profile-shadow-sm);
}

.profile-kicker,
.profile-eyebrow,
.profile-card-label,
.profile-identity-label {
    margin: 0 0 8px;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;

    color: var(--profile-blue);
}

.profile-hero-copy h1 {
    margin: 0;

    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;

    color: var(--profile-grey-900);
}

.profile-hero-description {
    max-width: 620px;
    margin: 16px 0 0;

    font-size: 15px;
    line-height: 1.7;

    color: var(--profile-grey-600);
}


/* =========================================================
   IDENTITY CARD
========================================================= */

.profile-identity-card {
    min-height: 250px;

    display: flex;
    align-items: center;
    gap: 22px;

    padding: 30px;

    border-radius: var(--profile-radius-lg);

    background:
        linear-gradient(
            145deg,
            var(--profile-blue-deep),
            var(--profile-blue)
        );

    box-shadow: var(--profile-shadow-md);

    color: var(--profile-white);
}

.profile-avatar-large {
    position: relative;

    flex: 0 0 auto;

    width: 112px;
    height: 112px;

    padding: 4px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.18);
}

.profile-avatar-large img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    border-radius: 50%;

    background: var(--profile-white);
}

.profile-avatar-large .profile-online-indicator {
    position: absolute;

    right: 5px;
    bottom: 7px;

    width: 18px;
    height: 18px;

    border: 3px solid var(--profile-blue-deep);
    border-radius: 50%;

    background: #22C55E;
}

.profile-identity-details {
    min-width: 0;
}

.profile-identity-label {
    color: rgba(255, 255, 255, 0.65);
}

.profile-identity-details h2 {
    margin: 0;

    font-size: 27px;
    line-height: 1.2;

    color: var(--profile-white);

    overflow-wrap: anywhere;
}

.profile-identity-details > p {
    margin: 8px 0 14px;

    font-size: 14px;

    color: rgba(255, 255, 255, 0.75);
}

.profile-role-badge {
    display: inline-flex;
    align-items: center;

    padding: 6px 11px;

    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;

    background: rgba(255, 255, 255, 0.12);

    font-size: 12px;
    font-weight: 700;

    color: var(--profile-white);
}


/* =========================================================
   SECTIONS
========================================================= */

.profile-section {
    max-width: 1240px;
    margin: 0 auto 38px;
}

.profile-section-heading {
    margin-bottom: 18px;
}

.profile-section-heading h2 {
    margin: 0;

    font-size: 25px;
    line-height: 1.25;

    color: var(--profile-grey-900);
}

.profile-section-heading p:not(.profile-eyebrow) {
    max-width: 700px;
    margin: 7px 0 0;

    font-size: 14px;
    line-height: 1.6;

    color: var(--profile-grey-500);
}


/* =========================================================
   OVERVIEW
========================================================= */

.profile-overview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.profile-wallet-card,
.profile-status-card {
    padding: 25px;

    border: 1px solid var(--profile-grey-200);
    border-radius: var(--profile-radius-md);

    background: var(--profile-white);

    box-shadow: var(--profile-shadow-sm);
}

.profile-wallet-card {
    border-top: 3px solid var(--profile-gold);
}

.profile-status-card {
    border-top: 3px solid var(--profile-blue);
}

.profile-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
}

.profile-card-label {
    display: block;
    margin-bottom: 9px;

    color: var(--profile-grey-500);
}

.profile-balance {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.025em;

    color: var(--profile-grey-900);
}

.profile-status-value {
    display: block;

    font-size: 28px;
    line-height: 1.2;

    color: var(--profile-success);
}

.profile-card-icon {
    width: 48px;
    height: 48px;

    flex: 0 0 auto;

    display: grid;
    place-items: center;

    border-radius: 13px;
}

.profile-card-icon.wallet {
    background: var(--profile-gold-light);
    color: var(--profile-gold-dark);
}

.profile-card-icon.status {
    background: var(--profile-blue-light);
    color: var(--profile-blue);
}

.profile-card-icon svg {
    width: 24px;
    height: 24px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.profile-wallet-card > p,
.profile-status-card > p {
    margin: 17px 0;

    font-size: 14px;
    line-height: 1.6;

    color: var(--profile-grey-600);
}

.profile-card-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;

    color: var(--profile-blue);
}

.profile-card-action:hover {
    color: var(--profile-blue-dark);
}

.profile-status-note {
    display: inline-flex;

    padding: 7px 10px;

    border-radius: 8px;

    background: var(--profile-blue-soft);

    font-size: 12px;
    font-weight: 600;

    color: var(--profile-blue-dark);
}


/* =========================================================
   INFORMATION CARDS
========================================================= */

.profile-information-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.profile-detail-card {
    padding: 25px;

    border: 1px solid var(--profile-grey-200);
    border-radius: var(--profile-radius-md);

    background: var(--profile-white);

    box-shadow: var(--profile-shadow-sm);
}

.profile-detail-header {
    display: flex;
    align-items: center;
    gap: 14px;

    padding-bottom: 18px;

    border-bottom: 1px solid var(--profile-grey-100);
}

.profile-detail-icon {
    width: 44px;
    height: 44px;

    flex: 0 0 auto;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: var(--profile-blue-light);
    color: var(--profile-blue);
}

.profile-detail-icon svg {
    width: 21px;
    height: 21px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.profile-detail-header h3 {
    margin: 0;

    font-size: 18px;

    color: var(--profile-grey-900);
}

.profile-detail-list {
    margin-top: 4px;
}

.profile-detail-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 25px;

    padding: 15px 0;

    border-bottom: 1px solid var(--profile-grey-100);
}

.profile-detail-row:last-child {
    border-bottom: 0;
}

.profile-detail-row span {
    font-size: 13px;
    color: var(--profile-grey-500);
}

.profile-detail-row strong {
    max-width: 65%;

    text-align: right;
    overflow-wrap: anywhere;

    font-size: 14px;
    font-weight: 700;

    color: var(--profile-grey-900);
}


/* =========================================================
   ACTIVITY
========================================================= */

.profile-activity-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}

.profile-activity-card {
    display: flex;
    align-items: center;
    gap: 13px;

    min-height: 92px;

    padding: 17px;

    border: 1px solid var(--profile-grey-200);
    border-radius: var(--profile-radius-md);

    background: var(--profile-white);

    box-shadow: var(--profile-shadow-sm);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
}

.profile-activity-card:hover {
    transform: translateY(-2px);

    border-color: var(--profile-grey-300);

    box-shadow: var(--profile-shadow-md);
}

.profile-activity-icon {
    width: 42px;
    height: 42px;

    flex: 0 0 auto;

    display: grid;
    place-items: center;

    border-radius: 11px;

    background: var(--profile-blue-soft);
    color: var(--profile-blue);
}

.profile-activity-icon svg {
    width: 20px;
    height: 20px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.profile-activity-card div {
    min-width: 0;
}

.profile-activity-card div span {
    display: block;

    margin-bottom: 4px;

    font-size: 12px;

    color: var(--profile-grey-500);
}

.profile-activity-card div strong {
    display: block;

    font-size: 14px;

    color: var(--profile-grey-900);
}


/* =========================================================
   ERROR
========================================================= */

.profile-error {
    max-width: 1240px;
    margin: 0 auto 30px;

    display: flex;
    align-items: center;
    gap: 14px;

    padding: 16px 18px;

    border: 1px solid #FECACA;
    border-radius: var(--profile-radius-md);

    background: #FEF2F2;

    color: #991B1B;
}

.profile-error strong {
    font-size: 14px;
}

.profile-error span {
    font-size: 13px;
}

.profile-error a {
    margin-left: auto;

    font-size: 13px;
    font-weight: 700;

    color: #991B1B;
}


/* =========================================================
   QUICK SERVICES
========================================================= */

.profile-services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.profile-service-card {
    position: relative;

    display: flex;
    align-items: flex-start;
    gap: 15px;

    min-height: 145px;

    padding: 22px;

    border: 1px solid var(--profile-grey-200);
    border-radius: var(--profile-radius-md);

    background: var(--profile-white);

    text-decoration: none;

    box-shadow: var(--profile-shadow-sm);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
}

.profile-service-card:hover {
    transform: translateY(-3px);

    border-color: rgba(30, 64, 175, 0.3);

    box-shadow: var(--profile-shadow-md);
}

.profile-service-icon {
    width: 44px;
    height: 44px;

    flex: 0 0 auto;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: var(--profile-blue-light);
    color: var(--profile-blue);
}

.profile-service-icon svg {
    width: 21px;
    height: 21px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.profile-service-card div {
    min-width: 0;
}

.profile-service-card h3 {
    margin: 1px 0 7px;

    font-size: 16px;

    color: var(--profile-grey-900);
}

.profile-service-card p {
    margin: 0;

    font-size: 13px;
    line-height: 1.55;

    color: var(--profile-grey-500);
}

.profile-service-arrow {
    position: absolute;

    right: 18px;
    bottom: 17px;

    font-size: 18px;
    font-weight: 700;

    color: var(--profile-blue);
}


/* =========================================================
   ACCESSIBILITY
========================================================= */

.profile-service-card:focus-visible,
.profile-card-action:focus-visible,
.profile-error a:focus-visible {
    outline: 3px solid rgba(30, 64, 175, 0.25);
    outline-offset: 3px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

    .profile-main {
        padding: 28px 24px 50px;
    }

    .profile-hero-v2 {
        grid-template-columns: 1fr;
    }

    .profile-activity-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile-services-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}


@media (max-width: 760px) {

    .profile-main {
        padding: 22px 16px 40px;
    }

    .profile-hero-v2 {
        gap: 16px;
        margin-bottom: 24px;
    }

    .profile-hero-copy {
        min-height: auto;
        padding: 27px 23px;
    }

    .profile-hero-copy h1 {
        font-size: 31px;
    }

    .profile-identity-card {
        min-height: auto;

        padding: 22px;

        gap: 16px;
    }

    .profile-avatar-large {
        width: 82px;
        height: 82px;
    }

    .profile-avatar-large .profile-online-indicator {
        width: 15px;
        height: 15px;

        right: 2px;
        bottom: 3px;
    }

    .profile-identity-details h2 {
        font-size: 21px;
    }

    .profile-overview-grid,
    .profile-information-grid {
        grid-template-columns: 1fr;
    }

    .profile-activity-grid,
    .profile-services-grid {
        grid-template-columns: 1fr;
    }

    .profile-section {
        margin-bottom: 30px;
    }

    .profile-section-heading h2 {
        font-size: 22px;
    }

    .profile-detail-row {
        flex-direction: column;
        gap: 5px;
    }

    .profile-detail-row strong {
        max-width: 100%;

        text-align: left;
    }

    .profile-error {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .profile-error a {
        margin-left: 0;
    }
}


@media (max-width: 480px) {

    .profile-identity-card {
        align-items: flex-start;
        flex-direction: column;
    }

    .profile-avatar-large {
        width: 76px;
        height: 76px;
    }

    .profile-balance {
        font-size: 29px;
    }

    .profile-status-value {
        font-size: 24px;
    }

    .profile-card-top {
        gap: 12px;
    }

    .profile-card-icon {
        width: 42px;
        height: 42px;
    }
}

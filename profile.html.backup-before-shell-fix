<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta
        name="description"
        content="Manage your student identity, campus information and account activity."
    >

    <title>My Profile | RI Student Environment</title>

    <!-- Shared RI styling -->
    <link rel="stylesheet" href="lostfound.css">

    <!-- Profile-specific styling -->
    <link rel="stylesheet" href="profile.css">
</head>

<body class="lf-page dashboard-page profile-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="lf-header">

        <div class="lf-header-left">

            <button
                id="hamburgerBtn"
                class="mobile-menu-button"
                type="button"
                aria-label="Open navigation menu"
                aria-controls="sidebarDrawer"
                aria-expanded="false"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>

            <a href="dashboard.html" class="lf-brand">

                <div class="lf-brand-mark">
                    <span>RI</span>
                </div>

                <div class="lf-brand-text">
                    <strong>RI Student Environment</strong>
                    <span>Student Portal</span>
                </div>

            </a>

        </div>

        <div class="lf-header-right">

            <button
                class="header-notification-button"
                type="button"
                aria-label="Notifications"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                    <path d="M10 21h4"></path>
                </svg>

                <span class="notification-dot" aria-hidden="true"></span>
            </button>

            <div class="header-student">

                <div
                    id="header-student-initial"
                    class="header-student-avatar"
                >
                    S
                </div>

                <div class="header-student-details">

                    <strong id="header-student-name">
                        Loading...
                    </strong>

                    <span id="header-student-role">
                        Student
                    </span>

                </div>

            </div>

        </div>

    </header>


    <!-- =========================================================
         MOBILE SIDEBAR OVERLAY
    ========================================================== -->

    <div
        id="sidebarOverlay"
        class="sidebar-overlay"
        hidden
    ></div>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside
        id="sidebarDrawer"
        class="lf-sidebar"
        aria-label="Student portal navigation"
    >

        <div class="sidebar-mobile-header">

            <strong>Student Portal</strong>

            <button
                id="sidebarClose"
                class="sidebar-close"
                type="button"
                aria-label="Close navigation menu"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>

        </div>


        <div class="sidebar-section">

            <div class="sidebar-section-label">
                Student Portal
            </div>

            <nav class="sidebar-nav">

                <a href="dashboard.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                    </svg>

                    <span>Dashboard</span>

                </a>


                <a
                    href="profile.html"
                    class="sidebar-link active"
                    aria-current="page"
                >

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="3.5"></circle>
                        <path d="M5 20c.7-3.2 3.1-5 7-5s6.3 1.8 7 5"></path>
                    </svg>

                    <span>Profile</span>

                </a>


                <a href="events.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                        <path d="M16 3v4M8 3v4M3 10h18"></path>
                    </svg>

                    <span>Events</span>

                </a>


                <a href="programs.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 5h16v14H4z"></path>
                        <path d="M8 9h8M8 13h6"></path>
                    </svg>

                    <span>Programs</span>

                </a>


                <a href="community.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20"></path>
                        <circle cx="9.5" cy="7" r="3"></circle>
                        <path d="M17 11a3 3 0 1 0-1-5.8"></path>
                        <path d="M21 20v-1.5a4 4 0 0 0-3-3.9"></path>
                    </svg>

                    <span>Community</span>

                </a>


                <a href="src.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3l7 4v5c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V7l7-4z"></path>
                        <path d="M9 12l2 2 4-4"></path>
                    </svg>

                    <span>SRC</span>

                </a>


                <a href="lostfound.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="6"></circle>
                        <path d="M16 16l5 5"></path>
                        <path d="M8.5 11h5"></path>
                    </svg>

                    <span>Lost &amp; Found</span>

                </a>


                <a href="store.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 9h16l-1 11H5L4 9z"></path>
                        <path d="M8 9V7a4 4 0 0 1 8 0v2"></path>
                    </svg>

                    <span>Store</span>

                </a>


                <a href="resturant.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 3v8"></path>
                        <path d="M4 3v5a3 3 0 0 0 6 0V3"></path>
                        <path d="M7 11v10"></path>
                        <path d="M16 3v18"></path>
                        <path d="M16 3c3 2 4 5 4 8h-4"></path>
                    </svg>

                    <span>Dining</span>

                </a>

            </nav>

        </div>


        <div class="sidebar-divider"></div>


        <div class="sidebar-section">

            <div class="sidebar-section-label">
                Account
            </div>

            <nav class="sidebar-nav">

                <a href="settings.html" class="sidebar-link">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-2.6V20a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H4.8v-2.6H5a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1L8 6.6l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6v-.2h2.6v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2V14h-.2a1.7 1.7 0 0 0-1.6 1z"></path>
                    </svg>

                    <span>Settings</span>

                </a>


                <a href="index.html" class="sidebar-link logout-button">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 5H5v14h5"></path>
                        <path d="M14 8l4 4-4 4"></path>
                        <path d="M18 12H9"></path>
                    </svg>

                    <span>Logout</span>

                </a>

            </nav>

        </div>


        <div class="sidebar-footer">

            <div class="sidebar-campus-label">
                Current Campus
            </div>

            <div
                id="sidebarCampusName"
                class="sidebar-campus-name"
            >
                Loading campus...
            </div>

            <div class="sidebar-footer-status">
                <span class="sidebar-status-dot"></span>
                Student Environment
            </div>

        </div>

    </aside>


    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->

    <main class="profile-main">


        <!-- =====================================================
             PROFILE HERO
        ====================================================== -->

        <section class="profile-hero-v3">

            <div class="profile-hero-copy">

                <span class="profile-kicker">
                    Student Identity
                </span>

                <h1>
                    My Profile
                </h1>

                <p>
                    Manage your student identity, campus information
                    and activity across the RI Student Environment.
                </p>

            </div>


            <div class="profile-identity-card">

                <div class="profile-avatar-wrapper">

                    <div
                        id="profile-picture"
                        class="profile-avatar"
                    >
                        <span id="profile-avatar-initial">
                            S
                        </span>
                    </div>

                    <span class="profile-avatar-status"></span>

                </div>


                <div class="profile-identity-content">

                    <span class="profile-eyebrow">
                        Student Account
                    </span>

                    <h2 id="profile-hero-name">
                        Loading...
                    </h2>

                    <p id="profile-hero-number">
                        Student number loading...
                    </p>

                    <div class="profile-identity-meta">

                        <span
                            id="profile-hero-role"
                            class="profile-role-badge"
                        >
                            Student
                        </span>

                        <span
                            id="profile-hero-campus"
                            class="profile-campus-badge"
                        >
                            Loading campus...
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             ACCOUNT OVERVIEW
        ====================================================== -->

        <section class="profile-overview-grid">


            <!-- WALLET -->

            <article class="profile-overview-card profile-wallet-card">

                <div class="profile-overview-card-top">

                    <div class="profile-overview-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="6" width="18" height="14" rx="2"></rect>
                            <path d="M16 10h5v6h-5a3 3 0 0 1 0-6z"></path>
                            <path d="M7 6V4h11l2 2"></path>
                            <circle cx="17" cy="13" r="1"></circle>
                        </svg>

                    </div>

                    <span class="profile-card-label">
                        Wallet Balance
                    </span>

                </div>

                <div
                    id="student-wallet-balance"
                    class="profile-wallet-amount"
                >
                    R0.00
                </div>

                <a href="store.html" class="profile-card-link">
                    Manage wallet
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>
                </a>

            </article>


            <!-- ACCOUNT STATUS -->

            <article class="profile-overview-card profile-status-card">

                <div class="profile-overview-card-top">

                    <div class="profile-overview-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3l7 4v5c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V7l7-4z"></path>
                            <path d="M9 12l2 2 4-4"></path>
                        </svg>

                    </div>

                    <span class="profile-card-label">
                        Account Status
                    </span>

                </div>

                <div class="profile-status-display">

                    <span class="profile-status-indicator"></span>

                    <strong id="profile-status">
                        Loading...
                    </strong>

                </div>

                <p class="profile-card-description">
                    Your student account status.
                </p>

            </article>

        </section>


        <!-- =====================================================
             PERSONAL INFORMATION
        ====================================================== -->

        <section class="profile-content-section">

            <div class="profile-section-heading">

                <div>
                    <span class="profile-eyebrow">
                        Identity
                    </span>

                    <h2>
                        Personal Information
                    </h2>

                    <p>
                        Your registered student account information.
                    </p>
                </div>

            </div>


            <div class="profile-details-grid">

                <article class="profile-detail-card">

                    <div class="profile-detail-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="3"></circle>
                            <path d="M5 20c.7-3.2 3.1-5 7-5s6.3 1.8 7 5"></path>
                        </svg>

                    </div>

                    <div class="profile-detail-content">

                        <span>
                            Full Name
                        </span>

                        <strong id="profile-full-name">
                            Loading...
                        </strong>

                    </div>

                </article>


                <article class="profile-detail-card">

                    <div class="profile-detail-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="4" y="5" width="16" height="14" rx="2"></rect>
                            <path d="M8 9h8M8 13h5"></path>
                        </svg>

                    </div>

                    <div class="profile-detail-content">

                        <span>
                            Student Number
                        </span>

                        <strong id="profile-student-number">
                            Loading...
                        </strong>

                    </div>

                </article>


                <article class="profile-detail-card">

                    <div class="profile-detail-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                            <path d="M3 7l9 6 9-6"></path>
                        </svg>

                    </div>

                    <div class="profile-detail-content">

                        <span>
                            Email Address
                        </span>

                        <strong id="profile-email">
                            Loading...
                        </strong>

                    </div>

                </article>


                <article class="profile-detail-card">

                    <div class="profile-detail-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 6h16v12H4z"></path>
                            <path d="M8 10h8M8 14h5"></path>
                        </svg>

                    </div>

                    <div class="profile-detail-content">

                        <span>
                            Account Role
                        </span>

                        <strong id="profile-role">
                            Loading...
                        </strong>

                    </div>

                </article>

            </div>

        </section>


        <!-- =====================================================
             CAMPUS INFORMATION
        ====================================================== -->

        <section class="profile-content-section">

            <div class="profile-section-heading">

                <div>
                    <span class="profile-eyebrow">
                        Campus
                    </span>

                    <h2>
                        Campus Information
                    </h2>

                    <p>
                        The campus associated with your student account.
                    </p>
                </div>

            </div>


            <div class="profile-campus-grid">

                <article class="profile-campus-card profile-campus-primary">

                    <div class="profile-campus-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 21h18"></path>
                            <path d="M5 21V9l7-5 7 5v12"></path>
                            <path d="M9 21v-5h6v5"></path>
                            <path d="M9 11h.01M15 11h.01"></path>
                        </svg>

                    </div>

                    <div>

                        <span>
                            Campus
                        </span>

                        <strong id="profile-campus">
                            Loading...
                        </strong>

                    </div>

                </article>


                <article class="profile-campus-card">

                    <div class="profile-campus-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                            <path d="M8 8h8M8 12h8M8 16h5"></path>
                        </svg>

                    </div>

                    <div>

                        <span>
                            Campus Code
                        </span>

                        <strong id="profile-campus-code">
                            Loading...
                        </strong>

                    </div>

                </article>


                <article class="profile-campus-card">

                    <div class="profile-campus-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z"></path>
                            <circle cx="12" cy="9" r="2.5"></circle>
                        </svg>

                    </div>

                    <div>

                        <span>
                            City
                        </span>

                        <strong id="profile-city">
                            Loading...
                        </strong>

                    </div>

                </article>

            </div>

        </section>


        <!-- =====================================================
             ACCOUNT ACTIVITY
        ====================================================== -->

        <section class="profile-content-section">

            <div class="profile-section-heading">

                <div>
                    <span class="profile-eyebrow">
                        Activity
                    </span>

                    <h2>
                        Account Activity
                    </h2>

                    <p>
                        Your activity across the Student Environment.
                    </p>
                </div>

            </div>


            <div class="profile-activity-grid">


                <!-- WALLET ACTIVITY -->

                <article class="profile-activity-card">

                    <div class="profile-activity-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="6" width="18" height="14" rx="2"></rect>
                            <path d="M16 10h5v6h-5a3 3 0 0 1 0-6z"></path>
                            <circle cx="17" cy="13" r="1"></circle>
                        </svg>

                    </div>

                    <div class="profile-activity-content">

                        <span>
                            Wallet
                        </span>

                        <strong id="profile-wallet-activity">
                            Connected
                        </strong>

                        <p>
                            View your wallet activity and transactions.
                        </p>

                    </div>

                    <a href="store.html" aria-label="Open wallet">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14"></path>
                            <path d="M13 6l6 6-6 6"></path>
                        </svg>

                    </a>

                </article>


                <!-- ORDERS -->

                <article class="profile-activity-card">

                    <div class="profile-activity-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 9h16l-1 11H5L4 9z"></path>
                            <path d="M8 9V7a4 4 0 0 1 8 0v2"></path>
                        </svg>

                    </div>

                    <div class="profile-activity-content">

                        <span>
                            Orders
                        </span>

                        <strong id="profile-order-activity">
                            Connected
                        </strong>

                        <p>
                            Access your Store and Dining orders.
                        </p>

                    </div>

                    <a href="store.html" aria-label="Open orders">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14"></path>
                            <path d="M13 6l6 6-6 6"></path>
                        </svg>

                    </a>

                </article>


                <!-- LOST & FOUND -->

                <article class="profile-activity-card">

                    <div class="profile-activity-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="6"></circle>
                            <path d="M16 16l5 5"></path>
                            <path d="M8.5 11h5"></path>
                        </svg>

                    </div>

                    <div class="profile-activity-content">

                        <span>
                            Lost &amp; Found
                        </span>

                        <strong id="profile-lostfound-activity">
                            Connected
                        </strong>

                        <p>
                            Manage your lost and found reports.
                        </p>

                    </div>

                    <a href="lostfound.html" aria-label="Open Lost and Found">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14"></path>
                            <path d="M13 6l6 6-6 6"></path>
                        </svg>

                    </a>

                </article>


                <!-- COMMUNITY -->

                <article class="profile-activity-card">

                    <div class="profile-activity-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20"></path>
                            <circle cx="9.5" cy="7" r="3"></circle>
                            <path d="M17 11a3 3 0 1 0-1-5.8"></path>
                        </svg>

                    </div>

                    <div class="profile-activity-content">

                        <span>
                            Community
                        </span>

                        <strong id="profile-message-activity">
                            Connected
                        </strong>

                        <p>
                            Access groups and student conversations.
                        </p>

                    </div>

                    <a href="community.html" aria-label="Open Community">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14"></path>
                            <path d="M13 6l6 6-6 6"></path>
                        </svg>

                    </a>

                </article>

            </div>

        </section>


        <!-- =====================================================
             QUICK ACCESS
        ====================================================== -->

        <section class="profile-content-section">

            <div class="profile-section-heading">

                <div>
                    <span class="profile-eyebrow">
                        Student Services
                    </span>

                    <h2>
                        Quick Access
                    </h2>

                    <p>
                        Jump directly to the services you use most.
                    </p>
                </div>

            </div>


            <div class="profile-services-grid">


                <a href="store.html" class="profile-service-card">

                    <div class="profile-service-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 9h16l-1 11H5L4 9z"></path>
                            <path d="M8 9V7a4 4 0 0 1 8 0v2"></path>
                        </svg>

                    </div>

                    <div>

                        <strong>
                            Campus Store
                        </strong>

                        <span>
                            Shop student products
                        </span>

                    </div>

                    <svg
                        class="profile-service-arrow"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>

                </a>


                <a href="resturant.html" class="profile-service-card">

                    <div class="profile-service-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3v8"></path>
                            <path d="M4 3v5a3 3 0 0 0 6 0V3"></path>
                            <path d="M7 11v10"></path>
                            <path d="M16 3v18"></path>
                            <path d="M16 3c3 2 4 5 4 8h-4"></path>
                        </svg>

                    </div>

                    <div>

                        <strong>
                            Campus Dining
                        </strong>

                        <span>
                            Browse campus food
                        </span>

                    </div>

                    <svg
                        class="profile-service-arrow"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>

                </a>


                <a href="lostfound.html" class="profile-service-card">

                    <div class="profile-service-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="6"></circle>
                            <path d="M16 16l5 5"></path>
                            <path d="M8.5 11h5"></path>
                        </svg>

                    </div>

                    <div>

                        <strong>
                            Lost &amp; Found
                        </strong>

                        <span>
                            Report or find an item
                        </span>

                    </div>

                    <svg
                        class="profile-service-arrow"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>

                </a>

            </div>

        </section>


        <!-- =====================================================
             ERROR MESSAGE
        ====================================================== -->

        <div
            id="profile-error"
            class="profile-error"
            hidden
            role="alert"
        >

            <div class="profile-error-icon">

